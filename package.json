{
  "name": "stayvo",
  "description": "Stayvo Check-in — digital guest portal for short-term rental hosts",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20 <24"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');if(fs.existsSync('.next'))fs.rmSync('.next',{recursive:true,force:true})\"",
    "postinstall": "node scripts/postinstall-macos-nosync.mjs",
    "dev": "bash scripts/dev.sh",
    "dev:phone": "HOST=0.0.0.0 bash scripts/dev.sh",
    "dev:hot": "bash scripts/dev-hot.sh",
    "dev:webpack": "bash scripts/dev-hot.sh",
    "dev:turbopack": "next dev --turbopack -H localhost",
    "dev:lan": "next dev --turbopack -H 0.0.0.0",
    "dev:clean": "npm run clean && bash scripts/dev.sh",
    "dev:prod": "npm run build && npm run start",
    "build": "next build",
    "start": "bash scripts/start.sh",
    "lint": "eslint .",
    "verify:brand": "node scripts/verify-brand-images.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "0.10.2",
    "@supabase/supabase-js": "2.105.1",
    "browser-image-compression": "^2.0.2",
    "framer-motion": "^12.38.0",
    "next": "16.2.5",
    "node-ical": "^0.20.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "eslint": "10.2.1",
    "eslint-config-next": "16.2.5",
    "postcss": "8.5.12",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vercel": "^53.1.0"
  }
}
